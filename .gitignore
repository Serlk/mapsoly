# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Map data and region packs (large, built by tool/build_region.sh)
/data/

# Cross-built routing server (tool/build_valhalla_android.sh regenerates it)
/android/app/src/main/jniLibs/*/libmapsoly_valhalla.so

# Cross-built MapLibre map engine and its glyphs/sprites
# (tool/build_maplibre_android.sh regenerates them)
/android/app/src/main/jniLibs/*/libmapsoly_mln.so
/android/app/src/main/assets/maplibre.zip
